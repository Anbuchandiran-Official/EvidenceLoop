# Copy to .env. Credentials remain on the server; never commit .env.
GEMINI_API_KEY=
TAVILY_API_KEY=
# Select a model available to your account.
GEMINI_MODEL=gemini-3-flash-preview
# legacy = responseMimeType + responseJsonSchema; format = responseFormat
GEMINI_SCHEMA_STYLE=legacy
# fixture = complete the run with an explicit no-facts demo response on Gemini 429; off = fail normally
GEMINI_FALLBACK_MODE=fixture
DATABASE_PATH=data/evidenceloop.sqlite3
MAX_SEARCHES=4
MAX_SOURCES=8
MAX_CLAIMS=8
FETCH_CONCURRENCY=4
RUN_TIMEOUT_SECONDS=600
# Optional, verified local price assumptions. Empty means cost is unknown.
INPUT_INR_PER_MILLION=
OUTPUT_INR_PER_MILLION=
SEARCH_INR_PER_CREDIT=
